rules_version = '2';

// Desabollito 2 · reglas de Firestore
// Pegar completo en: Firebase Console → Firestore Database → Reglas → Publicar
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function company(cid) { return get(/databases/$(database)/documents/companies/$(cid)).data; }
    function isMember(cid) { return signedIn() && uid() in company(cid).members; }
    function isAdmin(cid) { return isMember(cid) && company(cid).roles[uid()] in ['owner', 'admin']; }
    // Cuentas aprobadas (las cuentas viejas no tienen el campo y cuentan como aprobadas)
    function aprobado() {
      let p = /databases/$(database)/documents/users/$(uid());
      return exists(p) && get(p).data.get('aprobado', true) == true;
    }

    // ── Perfil propio ────────────────────────────────────────
    // La aprobación y el WhatsApp vinculado los escribe solo el bot (cuenta de servicio).
    match /users/{userId} {
      allow read, delete: if signedIn() && uid() == userId;
      allow create: if signedIn() && uid() == userId
        && request.resource.data.get('aprobado', false) == false
        && !('whatsapp' in request.resource.data);
      allow update: if signedIn() && uid() == userId
        && request.resource.data.get('aprobado', true) == resource.data.get('aprobado', true)
        && request.resource.data.get('rechazado', false) == resource.data.get('rechazado', false)
        && (request.resource.data.get('whatsapp', '') == resource.data.get('whatsapp', '')
            || !('whatsapp' in request.resource.data));   // solo se puede desvincular, no poner otro número
    }

    // ── Nombres de usuario únicos → { uid, name } ────────────
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == uid()
                    && name.matches('^[a-z0-9._-]{3,64}$')
                    && (request.resource.data.get('pendiente', false) == true || aprobado());
      allow update: if signedIn() && resource.data.uid == uid() && request.resource.data.uid == uid()
                    && (request.resource.data.get('pendiente', false) == resource.data.get('pendiente', false) || aprobado());
      allow delete: if signedIn() && resource.data.uid == uid();
    }

    // bot_sesiones y bot_mensajes: solo los usa el bot (cuenta de servicio).

    // ── Operativos (colección companies) ─────────────────────
    match /companies/{cid} {
      allow read: if signedIn() && uid() in resource.data.members;

      // Al crear, quien crea es el único miembro y es el dueño
      allow create: if signedIn() && aprobado()
        && request.resource.data.ownerId == uid()
        && request.resource.data.members == [uid()]
        && request.resource.data.roles[uid()] == 'owner';

      // Dueño y administradores editan; nadie puede cambiar el dueño
      // ni quitarle el rol de dueño.
      allow update: if signedIn()
        && resource.data.roles[uid()] in ['owner', 'admin']
        && request.resource.data.ownerId == resource.data.ownerId
        && resource.data.ownerId in request.resource.data.members
        && request.resource.data.roles[resource.data.ownerId] == 'owner';

      // Cualquier miembro (que no sea el dueño) puede irse solo
      allow update: if signedIn()
        && uid() in resource.data.members
        && uid() != resource.data.ownerId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'roles', 'memberNames', 'memberTags'])
        && !(uid() in request.resource.data.members)
        && request.resource.data.members.size() == resource.data.members.size() - 1;

      // Cada miembro puede actualizar solo su propia foto y su @usuario en el operativo
      allow update: if signedIn()
        && uid() in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberPhotos', 'memberUsers'])
        && request.resource.data.get('memberPhotos', {}).diff(resource.data.get('memberPhotos', {})).affectedKeys().hasOnly([uid()])
        && request.resource.data.get('memberUsers', {}).diff(resource.data.get('memberUsers', {})).affectedKeys().hasOnly([uid()]);

      allow delete: if signedIn() && resource.data.ownerId == uid();

      // ── Vehículos del operativo ────────────────────────────
      match /vehicles/{vid} {
        function esDueno(cid) {
          return resource.data.createdBy == uid() || resource.data.get('createdByUid', '') == uid() || isAdmin(cid);
        }
        allow read: if isMember(cid);
        allow create: if isMember(cid) && request.resource.data.createdBy == uid();
        // Quien lo cargó y los administradores pueden todo; quien recibió acceso de edición
        // puede editar los datos. El resto solo cambia el estado, agrega fotos/documentos y firma.
        allow update: if isMember(cid)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.get('createdByUid', '') == resource.data.get('createdByUid', '')
          && (esDueno(cid) || request.resource.data.get('deleted', false) == resource.data.get('deleted', false))
          && (esDueno(cid) || request.resource.data.get('editores', []) == resource.data.get('editores', []))
          && (esDueno(cid) || uid() in resource.data.get('editores', [])
              || (request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['estado', 'fechas', 'fotos', 'archivos', 'firma', 'historial', 'updatedAt', 'updatedBy'])
                  && request.resource.data.get('fotos', []).size() >= resource.data.get('fotos', []).size()
                  && request.resource.data.get('archivos', []).size() >= resource.data.get('archivos', []).size()));
        allow delete: if isAdmin(cid)
          || (isMember(cid) && (resource.data.createdBy == uid() || resource.data.get('createdByUid', '') == uid()));
      }

      // ── Solicitudes de eliminación (las resuelven los administradores)
      match /solicitudes/{sid} {
        allow read: if isAdmin(cid) || (isMember(cid) && resource.data.pedidoPor == uid());
        allow create: if isMember(cid) && request.resource.data.pedidoPor == uid();
        allow delete: if isAdmin(cid) || (isMember(cid) && resource.data.pedidoPor == uid());
      }

      // ── Gastos del operativo ───────────────────────────────
      match /gastos/{gid} {
        allow read: if isMember(cid);
        allow create: if isMember(cid) && request.resource.data.createdBy == uid()
          && request.resource.data.monto is number && request.resource.data.monto >= 0;
        allow update: if isMember(cid)
          && request.resource.data.createdBy == resource.data.createdBy
          && (isAdmin(cid) || resource.data.createdBy == uid());
        allow delete: if isAdmin(cid)
          || (isMember(cid) && resource.data.createdBy == uid());
      }
    }

    // Todo lo que no esté listado arriba queda cerrado.
  }
}
